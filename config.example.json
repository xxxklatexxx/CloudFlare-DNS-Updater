{
  "zone_id": "00000000000000000000000000000000",
  "interval": "5m",
  "request_timeout": "10s",
  "ipv4": { "url": "https://api.ipify.org" },
  "records": [
    { "name": "home.example.com", "type": "A" },
    { "name": "vpn.example.com", "type": "A" }
